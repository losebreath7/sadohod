# COPY to .env.public on the VPS. Never commit the actual .env.public.
# Set real secrets before the first public startup.
API_DOMAIN=api.example.com
SADOHOD_ENV=staging
DEMO_SEED=0
POSTGRES_PASSWORD=
# Only needed for browser apps served from separate origins.
ALLOWED_ORIGINS=
PHOTO_SEARCH_MIN_SCORE=0.20
# Do not set SADOHOD_BIND: API port 8000 is bound to loopback by the base Compose file.
# Preserve SMTP_* and TELEGRAM_* securely here when activating those integrations.
