# Copy to .env.production on a NEW VPS only. Never commit filled secrets.
# Password must be URL-safe (e.g. openssl rand -hex 32) for DATABASE_URL.
SADOHOD_ENV=production
DEMO_SEED=0
API_DOMAIN=api.example.com
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_FROM=no-reply@example.com
SMTP_USER=REPLACE_WITH_REAL_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_REAL_SMTP_PASSWORD
# CORS only for actual HTTPS browser frontends; native clients do not require CORS.
ALLOWED_ORIGINS=
PHOTO_SEARCH_MIN_SCORE=0.20
# Optional support bridge credentials. Empty means disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
