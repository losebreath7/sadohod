{"content":[{"type":"text","text":"const assetPathPrefix = \"https://www.figma.com/api/mcp/asset/d6249027-c95a-4dd0-a116-beefa7ea8dd8\";\nconst imgImage17 = `${assetPathPrefix}/045ce.png`;\nconst imgSubtract = `${assetPathPrefix}/aa689.svg`;\nconst img = `${assetPathPrefix}/342fc.svg`;\nconst img1 = `${assetPathPrefix}/a5de6.svg`;\nconst img2 = `${assetPathPrefix}/3154a.svg`;\n\nexport default function Component() {\n  return (\n    <div className=\"bg-[#f0efeb] relative size-full\" data-node-id=\"366:15969\" data-name=\"добавить товар выбор фотографии\">\n      <div className=\"-translate-x-1/2 absolute h-[100px] left-[calc(50%-0.21px)] top-0 w-[397.572px]\" data-node-id=\"366:15982\" data-name=\"Subtract\">\n        <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgSubtract} />\n      </div>\n      <p className=\"-translate-x-1/2 [word-break:break-word] absolute font-['Helvetica:Bold'] leading-[normal] left-1/2 not-italic text-[16px] text-black text-center top-[67px] w-[330px]\" data-node-id=\"366:15987\">\n        добавить товар\n      </p>\n      <p className=\"[word-break:break-word] absolute font-['Helvetica:Regular'] leading-[normal] left-[50px] not-italic text-[#a5a5a5] text-[12px] top-[494px] whitespace-nowrap\" data-node-id=\"366:15988\">{` `}</p>\n      <p className=\"[word-break:break-word] absolute font-['Helvetica:Regular'] leading-[normal] left-[157px] not-italic text-[16px] text-white top-[841px] whitespace-nowrap\" data-node-id=\"366:15989\">\n        сохранить\n      </p>\n      <a className=\"-translate-x-1/2 absolute block cursor-pointer h-[630px] left-[calc(50%+0.5px)] top-[106px] w-[439px]\" data-node-id=\"366:15990\" data-name=\"image 17\">\n        <div className=\"absolute inset-0 overflow-hidden pointer-events-none\">\n          <img alt=\"\" className=\"absolute h-[151.69%] left-0 max-w-none top-[-24.18%] w-full\" src={imgImage17} />\n        </div>\n      </a>\n      <div className=\"absolute bg-white h-[60px