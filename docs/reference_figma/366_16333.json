{"content":[{"type":"text","text":"const assetPathPrefix = \"https://www.figma.com/api/mcp/asset/8cf46dce-fb58-45ed-862b-ec9b76e13a79\";\nconst img = `${assetPathPrefix}/83ac5.svg`;\nconst img1 = `${assetPathPrefix}/c4e1e.svg`;\nconst img2 = `${assetPathPrefix}/a5de6.svg`;\nconst imgSubtract = `${assetPathPrefix}/aa689.svg`;\nconst imgGroup215 = `${assetPathPrefix}/8974e.svg`;\n\nfunction NavStores({ className }: { className?: string }) {\n  return (\n    <div className={className || \"bg-white h-[60px] relative w-[390px]\"} data-node-id=\"336:783\" data-name=\"САДОХОД / nav / stores\">\n      <div className=\"absolute left-[52.5px] size-[27px] top-[16.5px]\" data-node-id=\"336:784\" data-name=\"Магазины\">\n        <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={img} />\n      </div>\n      <div className=\"absolute left-[169.5px] size-[27px] top-[16.5px]\" data-node-id=\"336:789\" data-name=\"Камера\">\n        <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={img1} />\n      </div>\n      <div className=\"absolute left-[286.5px] size-[27px] top-[16.5px]\" data-node-id=\"336:792\" data-name=\"Профиль\">\n        <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={img2} />\n      </div>\n    </div>\n  );\n}\n\nexport default function Component1() {\n  return (\n    <div className=\"bg-[#f0efeb] relative size-full\" data-node-id=\"366:16333\" data-name=\"мои магазины 1\">\n      <div className=\"absolute bg-[#f0efeb] h-[57px] left-[438.91px] top-[106px] w-[37.174px]\" data-node-id=\"366:16361\" />\n      <div className=\"-translate-x-1/2 absolute h-[100px] left-[calc(50%-0.21px)] top-[-1px] w-[397.572px]\" data-node-id=\"366:16362\" data-name=\"Subtract\">\n        <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgSubtract} />\n      </div>\n      <p className=\"-translate-x-1/2 [word-break:break-word] absolute font-['Helvetica:Bold'] leading-[normal] left-1/2 not-italic text-[16px] text-black text-center top-[67px] w-[330px]\" data-node-id=\"366:16367\">\n        мои магазины\n      </p>\n      <p className=\"[word-break:break-word] absolute font-['Helvetica:Regular'] leading-[normal] left-[50px] not-italic text-[#a5a5a5] text-[12px] top-[383px] whitespace-nowrap\" data-node-id=\"366:16368\">{` `}</p>\n      <NavStores className=\"absolute bg-white h-[60px] left-0 top-[638px] w-[390px]\" />\n      <div className=\"absolute bg-[rgba(255,255,255,0)] h-[60px] left-[125px] top-[895px] w-[110px]\" data-node-id=\"366:16403\" data-name=\"NAV / Камера\" />\n      <div className=\"absolute bg-[rgba(255,255,255,0)] h-[60px] left-[242px] top-[895px] w-[110px]\" data-node-id=\"366:16404\" data-name=\"NAV / Профиль\" />\n      <button className=\"[word-break:break-word] absolute block cursor-pointer font-['Helvetica:Regular'] leading-[0] left-[33px] not-italic text-[30px] text-black text-left top-[58px] whitespace-nowrap\" data-node-id=\"366:16406\">\n        <p className=\"leading-[normal]\">‹</p>\n      </button>\n      <a className=\"-translate-x-1/2 [word-break:break-word] absolute bg-[#d9d9d9] block cursor-pointer h-[70px] leading-[normal] left-1/2 not-italic overflow-clip rounded-[10px] text-[12px] text-left top-[297px] w-[330px] whitespace-nowrap\" data-node-id=\"366:16310\" data-name=\"Состояние павильона / Б-2В-86\">\n        <p className=\"absolute font-['Helvetica:Regular'] left-[241px] text-[#7d7d7d] top-[calc(50%-8px)]\" data-node-id=\"366:16312\">\n          на проверке\n        </p>\n        <div className=\"-translate-y-1/2 absolute contents left-[14px] top-[calc(50%-0.5px)]\" data-node-id=\"366:17040\">\n          <p className=\"absolute font-['Helvetica:Bold'] left-[14px] text-[#2c1b15] top-[calc(50%-20px)]\" data-node-id=\"366:16311\">\n            Б-2В-86\n          </p>\n          <p className=\"absolute font-['Helvetica:Regular'] left-[14px] text-[#595959] top-[calc(50%+5px)]\" data-node-id=\"366:17038\">\n            Paulo Gondoni 3\n          </p>\n        </div>\n      </a>\n      <a className=\"-translate-x-1/2 [word-break:break-word] absolute bg-[#5f0f10] block cursor-pointer h-[70px] leading-[normal] left-1/2 not-italic overflow-clip rounded-[10px] text-[12px] text-left top-[378px] w-[330px] whitespace-nowrap\" data-node-id=\"366:17031\" data-name=\"Состояние павильона / Б-2В-86\">\n        <p className=\"absolute font-['Helvetica:Regular'] left-[260px] text-[#d9d9d9] top-[calc(50%-8px)]\" data-node-id=\"366:17033\">\n          отклонен\n        </p>\n        <div className=\"-translate-y-1/2 absolute contents left-[14px] top-[calc(50%-0.5px)]\" data-node-id=\"366:17041\">\n          <p className=\"absolute font-['Helvetica:Bold'] left-[14px] text-white top-[calc(50%-20px)]\" data-node-id=\"366:17032\">\n            Б-2В-86\n          </p>\n          <p className=\"absolute font-['Helvetica:Regular'] left-[14px] text-[#d9d9d9] top-[calc(50%+5px)]\" data-node-id=\"366:17039\">\n            Paulo Gondoni 3\n          </p>\n        </div>\n      </a>\n      <a className=\"-translate-x-1/2 absolute bg-white block cursor-pointer h-[70px] left-1/2 overflow-clip rounded-[10px] top-[216px] w-[330px]\" data-node-id=\"366:17034\" data-name=\"Состояние павильона / Б-2В-86\">\n        <div className=\"-translate-y-1/2 [word-break:break-word] absolute contents leading-[normal] left-[14px] not-italic text-[12px] text-left top-[calc(50%-0.5px)] whitespace-nowrap\" data-node-id=\"366:17043\">\n          <p className=\"absolute font-['Helvetica:Bold'] left-[14px] text-[#1a1a1a] top-[calc(50%-20px)]\" data-node-id=\"366:17035\">\n            Б-2В-86\n          </p>\n          <p className=\"absolute font-['Helvetica:Regular'] left-[14px] text-[#595959] top-[calc(50%+5px)]\" data-node-id=\"366:17036\">\n            Paulo Gondoni 2\n          </p>\n        </div>\n        <div className=\"absolute flex items-center justify-center left-[301px] top-[calc(50%-18px)]\" data-node-id=\"36