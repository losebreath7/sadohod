FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt pytest "httpx>=0.27,<0.29"
COPY backend ./backend
COPY preview ./preview
COPY demo_data ./demo_data
CMD ["sh", "-ec", "DATABASE_URL=sqlite:////tmp/sadohod-qa.db SADOHOD_QA=0 python -m pytest -q backend/tests && python -m pytest -q backend/tests/test_postgres_search_change.py backend/tests/test_postgres_migrations.py backend/tests/test_postgres_onboarding.py"]
